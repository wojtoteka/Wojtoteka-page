# Zaleznosci
node_modules/
npm-debug.log*

# Ustawienia z haslami i kluczami. Wzor lezy w .env.example.
.env
.env.local

# Pliki wgrywane przez panel - dane uzytkownikow, nie do repozytorium.
uploads/

# Zrzuty bazy - maja dane wszystkich wiadomosci i kont.
*.sql
*.sql.gz

# Ciezkie binaria: instalatory, muzyka, wideo. Serwowane sa z dysku serwera,
# a nie z repozytorium - GitHub i tak nie przyjmuje plikow >100 MB.
*.exe
*.deb
*.AppImage
*.mp3
*.mp4
public/inne/litho/file/

.vscode/
.DS_Store

# Next.js i TypeScript
.next/
*.tsbuildinfo

# Notatki dla asystentów AI, które `next dev` tworzy sam przy starcie.
AGENTS.md
CLAUDE.md

# Kopie usuniętych stron (hack, nonStopPop) - trzymane lokalnie, poza serwisem.
stare-strony/
