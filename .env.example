# Wzor pliku .env. Skopiuj jako .env i uzupelnij.
#
# Prawdziwy .env NIE trafia do repozytorium (patrz .gitignore) - ma w srodku
# hasla i klucze. Tu stoja same nazwy i wartosci domyslne.

# --- Baza danych MariaDB / MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=kontakt_db

# --- Poczta (powiadomienia o nowych wiadomosciach) ---
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# --- Monitoring dostepnosci (HetrixTools) ---
HETRIX_KEY=
HETRIX_REPORT_URL=

# --- hCaptcha (formularz kontaktowy) ---
HCAPTCHA_SECRET=
HCAPTCHA_SITE_KEY=

# --- Sesje ---
# Dlugi, losowy ciag. Wygeneruj np.: openssl rand -hex 32
SESSION_SECRET=

# --- Serwer ---
PORT=7000
# production wlacza przekierowanie na HTTPS
NODE_ENV=development
