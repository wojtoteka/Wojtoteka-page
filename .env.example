# Wzor pliku .env. Skopiuj jako .env i uzupelnij.
#
# Prawdziwy .env NIE trafia do repozytorium (patrz .gitignore) - ma w srodku
# hasla i klucze. Tu stoja same nazwy i wartosci domyslne.

# --- Baza danych MariaDB / MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=kontakt_db

# --- Poczta (powiadomienia o nowych wiadomosciach) ---
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# --- Monitoring dostepnosci (HetrixTools, strona /status) ---
# Klucz API v3 z https://hetrixtools.com/dashboard/account/api/
# Wystarcza zakres: v3 GET Uptime Monitors, Uptime Report, Downtimes, Status Pages.
# RAM na zywo wymaga dodatkowo v3 GET Server Agent Metrics.
# Bez tego zakresu: odczyt zapasowy przez v1 Server Stats (jesli klucz ma dostep),
# z rzadszym odswiezaniem ze wzgledu na miesieczny limit API v1.
HETRIX_KEY=
# Adres strony statusu w HetrixTools (https://wl.hetrixtools.com/r/<id>/) albo samo <id>.
# Z niej brana jest lista i kolejnosc serwerow. Pusto: monitory z publicznym raportem.
HETRIX_REPORT_URL=

# --- hCaptcha (formularz kontaktowy) ---
HCAPTCHA_SECRET=
HCAPTCHA_SITE_KEY=

# --- Sesje (Auth.js) i podpisy ---
# Dlugi, losowy ciag. Wygeneruj np.: openssl rand -hex 32
# AUTH_SECRET ma pierwszenstwo. Jesli go nie ma, uzywany jest SESSION_SECRET
# (zgodnosc ze starym .env). Zmiana sekretu wylogowuje wszystkich.
AUTH_SECRET=
SESSION_SECRET=

# --- Serwer ---
PORT=7000
# Domyslnie 127.0.0.1 (tylko lokalnie, za reverse proxy).
HOST=127.0.0.1
# production wlacza przekierowanie na HTTPS, HSTS i bezpieczne ciasteczka
NODE_ENV=development
# off: build produkcyjny bez wymuszania HTTPS (np. test lokalny po http)
HTTPS_REDIRECT=
